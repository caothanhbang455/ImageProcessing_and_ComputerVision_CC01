# Local datasets and research source material. Keep them out of the shared repository.
/dataset/
/datasets/
/raw/
/paper/

# Preserve the old local notebook separately. New project notebooks belong in /notebooks/.
/notebook/

# Model weights, training artifacts, predictions, and generated analysis.
/checkpoints/
/weights/
/runs/
/outputs/
/results/
/reports/eda/
/reports/baselines/
/artifacts/
/wandb/
/lightning_logs/
/mlruns/

# Large archives and model files anywhere in the tree.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.pt
*.pth
*.pkl
*.ckpt
*.safetensors
*.onnx

# Generated binary arrays and geometry/image annotations.
*.npy
*.npz
*.h5
*.hdf5
*.exr

# Python and notebook caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments and private environment variables.
.venv/
venv/
env/
.env
.env.*
!.env.example

# Temporary and local editor files.
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Intentionally NOT ignored: /data/ (dataset Python code), /documentation/,
# /notebooks/ (committed notebook sources), and /tests/.

# Local file inventories and Git diagnostic exports.
/files.txt
/git_status*.txt
/repo_inventory*.txt

/CLAUDE.md

/stage2_manifest.json
